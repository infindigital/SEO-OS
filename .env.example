# ---------------------------------------------------------------------------
# Infin Digital — SEO OS environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma) — Supabase Postgres connection strings
# DATABASE_URL uses the pooled connection (PgBouncer, port 6543).
# DIRECT_URL uses the direct connection (port 5432) for migrations.
DATABASE_URL=
DIRECT_URL=

# Authentication — comma-separated emails bootstrapped as ADMIN on signup.
# Everyone else registers as CLIENT; admins can promote users to DEVELOPER/ADMIN.
SEED_ADMIN_EMAILS=

# SEO crawler — path to the Chromium executable used by Playwright
# (playwright-core does not bundle a browser). Example:
#   /opt/pw-browsers/chromium  or  $(npx playwright-core install chromium && ...)
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
