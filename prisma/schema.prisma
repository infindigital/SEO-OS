// Prisma schema for the Infin Digital SEO OS.
// Data models are added incrementally as features are built.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Access-control role assigned to a user profile.
enum UserRole {
  ADMIN
  DEVELOPER
  CLIENT
}

/// Application profile for a Supabase-authenticated user. `id` matches the
/// Supabase `auth.users` id. Role is the source of truth for authorization.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

/// Lifecycle stage of a client engagement.
enum ClientStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

/// A client workspace managed within the SEO OS.
model Client {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  website      String?
  contactName  String?      @map("contact_name")
  contactEmail String?      @map("contact_email")
  status       ClientStatus @default(PROSPECT)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([name])
  @@map("clients")
}
