// Prisma schema for the Infin Digital SEO OS.
// Data models are added incrementally as features are built.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A daily snapshot of headline metrics powering the dashboard. One row per
/// day; populated by analytics/ETL (or the demo seed).
model DailyMetric {
  id                String   @id @default(uuid()) @db.Uuid
  date              DateTime @unique @db.Date
  organicTraffic    Int      @map("organic_traffic")
  seoScore          Int      @map("seo_score")
  openTasks         Int      @map("open_tasks")
  developerProgress Int      @map("developer_progress")
  contentProgress   Int      @map("content_progress")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("daily_metrics")
}

/// Access-control role assigned to a user profile.
enum UserRole {
  ADMIN
  DEVELOPER
  CLIENT
}

/// Application profile for a Supabase-authenticated user. `id` matches the
/// Supabase `auth.users` id. Role is the source of truth for authorization.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

/// Lifecycle stage of a client engagement.
enum ClientStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

/// A client workspace managed within the SEO OS.
model Client {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  website      String?
  contactName  String?      @map("contact_name")
  contactEmail String?      @map("contact_email")
  status       ClientStatus @default(PROSPECT)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  searchConsoleConnections SearchConsoleConnection[]

  @@index([status])
  @@index([name])
  @@map("clients")
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SearchDimension {
  QUERY
  PAGE
}

/// A connected Google Search Console property for a client.
model SearchConsoleConnection {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @map("client_id") @db.Uuid
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteUrl      String           @map("site_url")
  refreshToken String?          @map("refresh_token")
  status       ConnectionStatus @default(CONNECTED)
  lastSyncedAt DateTime?        @map("last_synced_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  analyticsRows SearchAnalyticsRow[]
  coverage      PageCoverage[]

  @@unique([clientId, siteUrl])
  @@map("search_console_connections")
}

/// A Search Console search-analytics row (per query or page, per day).
model SearchAnalyticsRow {
  id           String                  @id @default(uuid()) @db.Uuid
  connectionId String                  @map("connection_id") @db.Uuid
  connection   SearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  dimension    SearchDimension
  keyValue     String                  @map("key_value")
  date         DateTime                @db.Date
  clicks       Int
  impressions  Int
  ctr          Float
  position     Float
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([connectionId, dimension, keyValue, date])
  @@index([connectionId, dimension, date])
  @@map("search_analytics_rows")
}

/// Index coverage status for a page, from the URL Inspection API.
model PageCoverage {
  id            String                  @id @default(uuid()) @db.Uuid
  connectionId  String                  @map("connection_id") @db.Uuid
  connection    SearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  page          String
  coverageState String                  @map("coverage_state")
  verdict       String
  lastCrawledAt DateTime?               @map("last_crawled_at")
  fetchedAt     DateTime                @default(now()) @map("fetched_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@unique([connectionId, page])
  @@map("page_coverage")
}
