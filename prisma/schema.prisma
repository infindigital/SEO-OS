// Prisma schema for the Infin Digital SEO OS.
// Data models are added incrementally as features are built.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A daily snapshot of headline metrics powering the dashboard. One row per
/// day; populated by analytics/ETL (or the demo seed).
model DailyMetric {
  id                String   @id @default(uuid()) @db.Uuid
  date              DateTime @unique @db.Date
  organicTraffic    Int      @map("organic_traffic")
  seoScore          Int      @map("seo_score")
  openTasks         Int      @map("open_tasks")
  completedTasks    Int      @default(0) @map("completed_tasks")
  criticalIssues    Int      @default(0) @map("critical_issues")
  monthlyRevenue    Int      @default(0) @map("monthly_revenue")
  developerProgress Int      @map("developer_progress")
  contentProgress   Int      @map("content_progress")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("daily_metrics")
}

/// Access-control role assigned to a user profile.
enum UserRole {
  ADMIN
  DEVELOPER
  CLIENT
}

/// Application profile for a Supabase-authenticated user. `id` matches the
/// Supabase `auth.users` id. Role is the source of truth for authorization.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedClients   Client[]        @relation("ClientOwner")
  assignedTasks  DeveloperTask[] @relation("TaskAssignee")

  @@map("profiles")
}

/// Lifecycle stage of a client engagement.
enum ClientStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

/// A client workspace managed within the SEO OS.
model Client {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  website         String?
  contactName     String?      @map("contact_name")
  contactEmail    String?      @map("contact_email")
  status          ClientStatus @default(PROSPECT)
  ownerId         String?      @map("owner_id") @db.Uuid
  owner           Profile?     @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  industry        String?
  monthlyRetainer Int?         @map("monthly_retainer")
  seoScore        Int?         @map("seo_score")
  lastAuditAt     DateTime?    @map("last_audit_at")
  currentFocus    String?      @map("current_focus")
  notes           String?
  archivedAt      DateTime?    @map("archived_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  searchConsoleConnections SearchConsoleConnection[]
  developerTasks           DeveloperTask[]

  @@index([status])
  @@index([name])
  @@index([ownerId])
  @@index([archivedAt])
  @@map("clients")
}

/// Priority of a developer task.
enum DevTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Workflow status of a developer task.
enum DevTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

/// A unit of engineering work tracked on the developer dashboard.
model DeveloperTask {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  description String?
  priority    DevTaskPriority @default(MEDIUM)
  status      DevTaskStatus   @default(OPEN)
  completion  Int             @default(0)
  dueDate     DateTime?       @map("due_date")
  assigneeId  String?         @map("assignee_id") @db.Uuid
  assignee    Profile?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  clientId    String?         @map("client_id") @db.Uuid
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  notes       DeveloperTaskNote[]
  screenshots DeveloperTaskScreenshot[]

  @@index([assigneeId])
  @@index([clientId])
  @@index([status])
  @@map("developer_tasks")
}

/// A timestamped note added to a developer task.
model DeveloperTaskNote {
  id        String        @id @default(uuid()) @db.Uuid
  taskId    String        @map("task_id") @db.Uuid
  task      DeveloperTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?       @map("author_id") @db.Uuid
  body      String
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([taskId])
  @@map("developer_task_notes")
}

/// A screenshot attached to a developer task (stored in object storage).
model DeveloperTaskScreenshot {
  id         String        @id @default(uuid()) @db.Uuid
  taskId     String        @map("task_id") @db.Uuid
  task       DeveloperTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId String?       @map("uploader_id") @db.Uuid
  path       String
  url        String?
  caption    String?
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([taskId])
  @@map("developer_task_screenshots")
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SearchDimension {
  QUERY
  PAGE
}

/// A connected Google Search Console property for a client.
model SearchConsoleConnection {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @map("client_id") @db.Uuid
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteUrl      String           @map("site_url")
  refreshToken String?          @map("refresh_token")
  status       ConnectionStatus @default(CONNECTED)
  lastSyncedAt DateTime?        @map("last_synced_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  analyticsRows SearchAnalyticsRow[]
  coverage      PageCoverage[]

  @@unique([clientId, siteUrl])
  @@map("search_console_connections")
}

/// A Search Console search-analytics row (per query or page, per day).
model SearchAnalyticsRow {
  id           String                  @id @default(uuid()) @db.Uuid
  connectionId String                  @map("connection_id") @db.Uuid
  connection   SearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  dimension    SearchDimension
  keyValue     String                  @map("key_value")
  date         DateTime                @db.Date
  clicks       Int
  impressions  Int
  ctr          Float
  position     Float
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([connectionId, dimension, keyValue, date])
  @@index([connectionId, dimension, date])
  @@map("search_analytics_rows")
}

/// Index coverage status for a page, from the URL Inspection API.
model PageCoverage {
  id            String                  @id @default(uuid()) @db.Uuid
  connectionId  String                  @map("connection_id") @db.Uuid
  connection    SearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  page          String
  coverageState String                  @map("coverage_state")
  verdict       String
  lastCrawledAt DateTime?               @map("last_crawled_at")
  fetchedAt     DateTime                @default(now()) @map("fetched_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@unique([connectionId, page])
  @@map("page_coverage")
}
